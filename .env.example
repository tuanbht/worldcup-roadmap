# ---------------------------------------------------------------------------
# WC Roadmap configuration. Copy to .env.local and adjust. All values optional:
# with no env at all, the app runs against the committed mock fixture.
# ---------------------------------------------------------------------------

# Frontend (Vite): the Hono API ORIGIN only — no trailing path. The SPA calls
# this directly, so prod works without the Vite /api proxy. Unset → the client
# falls back to a relative /api path (the dev Vite proxy resolves it).
#   dev example:  http://localhost:8787
#   prod example: https://api.roadmap.example.com
# VITE_API_BASE_URL=http://localhost:8787

# Server CORS for direct cross-origin SPA → API GETs. Unset on both → no CORS
# headers (same-origin default). Set either or both; they are unioned.
#   CORS_ALLOWED_ORIGINS — comma-separated allowlist (dev + prod SPA origins).
#   CORS_ALLOWED_ORIGIN  — legacy single origin, still supported (back-compat).
# CORS_ALLOWED_ORIGINS=http://localhost:3217,https://roadmap.example.com
# CORS_ALLOWED_ORIGIN=https://roadmap.example.com

# Which data provider to use.
#   auto  -> FIFA when reachable, otherwise the mock fixture (default)
#   fifa  -> force the official FIFA API (api.fifa.com/api/v3)
#   mock  -> force the bundled offline fixture
WC_PROVIDER=auto

# FIFA World Cup 2026 identifiers (verified against api.fifa.com/api/v3).
WC_FIFA_COMPETITION_ID=17
WC_FIFA_SEASON_ID=285023

# Cache time-to-live (milliseconds). Live = when any match is in play.
WC_CACHE_TTL_LIVE_MS=30000
WC_CACHE_TTL_IDLE_MS=600000

# Optional country hint forwarded to FIFA (mirrors the fifa.com ?country= param).
WC_FIFA_COUNTRY=US
